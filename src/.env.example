# Pekopeko local device configuration - secrets/sensitive overrides.
#
# Copy this file to ".env" and place it NEXT TO the resolved config.yaml
# (default: src/.env, or wherever PEKOPEKO_CONFIG_PATH points) -
# NOT in the repo. It is loaded via python-dotenv and only recognizes the
# same bounded PEKOPEKO_* keys documented in src/README.md's "Configuration"
# section; a real process environment variable always wins over a value set
# here. Never commit a real .env file - add it to .gitignore.

PEKOPEKO_LLM_PROVIDER=ollama
PEKOPEKO_OLLAMA_BASE_URL=http://localhost:11434
PEKOPEKO_OLLAMA_MODEL=llama3
PEKOPEKO_OLLAMA_TIMEOUT=60
PEKOPEKO_TASK_STATE_DIR=./.pekopeko/task_state
PEKOPEKO_RETRIEVAL_INDEX_DIR=./.pekopeko/retrieval_index
